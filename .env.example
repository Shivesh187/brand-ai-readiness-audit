# Brand AI Readiness Audit - Environment Configuration Example
# Copy this file to .env or set environment variables in your shell before running audits.

# Optional Gemini API Key for AI Reasoning & Candidate Validation
# If omitted or invalid, audit engine gracefully falls back to deterministic rules.
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (Default: gemini-3.7-flash)
GEMINI_MODEL=gemini-3.7-flash
